{
  "skill_name": "renderdoc-python-builder",
  "version": "1.1.0",
  "author": "RenderDoc Python Modules Team",
  "description": "Build RenderDoc Python extension modules for Windows",

  "default_build": {
    "python_version": "auto",
    "config": "Development",
    "platform": "x64",
    "platform_toolset": "v143"
  },

  "supported_python_versions": [
    "3.6",
    "3.7",
    "3.8",
    "3.9",
    "3.10",
    "3.11",
    "3.12",
    "3.13"
  ],

  "supported_configs": [
    "Development",
    "Release"
  ],

  "supported_platforms": [
    "x64",
    "x86"
  ],

  "output_structure": {
    "base_dir": "<platform>/<config>/pymodules",
    "modules": [
      "renderdoc.pyd",
      "qrenderdoc.pyd"
    ],
    "dependencies": [
      "renderdoc.dll",
      "d3dcompiler_47.dll"
    ]
  },

  "auto_fixes": {
    "python_313_compat": {
      "enabled": true,
      "description": "Add /wd4996 to ignore Python 3.13+ deprecation warnings",
      "projects": [
        "qrenderdoc/Code/pyrenderdoc/pyrenderdoc_module.vcxproj",
        "qrenderdoc/Code/pyrenderdoc/qrenderdoc_module.vcxproj"
      ]
    }
  },

  "report_generation": {
    "enabled": true,
    "output_file": "REPORT.md",
    "format": "markdown",
    "sections": [
      "environment",
      "build_config",
      "modules",
      "output_files",
      "test_results",
      "usage_instructions"
    ]
  }
}
